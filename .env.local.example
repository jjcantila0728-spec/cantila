# Cantila Console — local environment overrides.
# Copy to .env.local to use: `cp .env.local.example .env.local`

# Where the Console reaches the control plane. The /api/cantila/* proxy
# route forwards to this URL. Default is http://localhost:8080, matching
# cantila-control-plane's default PORT.
CANTILA_CONTROL_PLANE_URL=http://localhost:8080

# Optional. When the control plane has CANTILA_REQUIRE_AUTH=true, set this
# to a deploy- or admin-scoped key minted by `cantila keys create` (or via
# the Settings page in the Console). The proxy injects it on every outbound
# request, so the browser never sees the key.
# CANTILA_API_KEY=ctk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Public origin the OAuth (Google/GitHub) callback is registered
# under — used to build the redirect_uri /auth/callback/<provider> sent to
# the control plane's /v1/auth/sso/start. Defaults to https://cantila.app in
# production and http://localhost:3000 in dev. Override only if the Console
# is served from a different apex. The matching CANTILA_GOOGLE_* /
# CANTILA_GITHUB_* OAuth credentials live on the control plane (unset = stub).
# CANTILA_PUBLIC_ORIGIN=http://localhost:3000
